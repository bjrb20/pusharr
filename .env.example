# Pusharr secrets. Copy to a private file (chmod 600) outside the repo and point ENV_FILE at it
# (mounted read-only), or pass these as environment variables. Everything else is in config.yaml.

# An API key made in Jellyfin -> Dashboard -> API Keys just for Pusharr (required)
JELLYFIN_API_KEY=

# Web push keys: python tools/gen_vapid.py <this file>  (required; never change them once people subscribed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for trusted services that send notifications (POST :8001/notify, Bearer token) (required)
INTERNAL_TOKEN=

# Login that Sonarr / Radarr / Seerr use for their webhooks (http://pusharr:8000/sonarr|radarr|seerr)
WEBHOOK_USER=
WEBHOOK_PASSWORD=

# API keys of the integrations you switch on in config.yaml
SEERR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=

# Signs the notification-button tokens (any long random string; set it so tokens survive a DB reset)
ACTION_SECRET=
